<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Elevación y sombra cuando el cursor esté por encima (hover) de una opción -->
    <item android:state_hovered="true">
        <set>
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="120"
                android:valueTo="8dp"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="elevation"
                android:duration="120"
                android:valueTo="6dp"
                android:valueType="floatType" />
        </set>
    </item>
    <!-- Estado presionado -->
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="80"
                android:valueTo="4dp"
                android:valueType="floatType" />
        </set>
    </item>
    <!-- Estado normal -->
    <item>
        <set>
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="120"
                android:valueTo="0dp"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="elevation"
                android:duration="120"
                android:valueTo="2dp"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
