{
  "rules": {
    "Pacientes": {
      ".read": true,
      ".write": true,
      "$nuhsa": {
        ".validate": "newData.hasChildren(['nuhsa', 'nombre', 'apellidos', 'grupoSanguineo']) && newData.child('nuhsa').val() === $nuhsa",
        "nuhsa": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{1,20}$/)" },
        "nombre": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50" },
        "apellidos": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50" },
        "grupoSanguineo": { ".validate": "newData.isString() && newData.val().matches(/^(A|B|AB|0)[+-]$/)" },
        "fechaNacimiento": { ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^[0-9]{2}\\/[0-9]{2}\\/[0-9]{4}$/))" },
        "$otro": { ".validate": false }
      }
    },
    "PacientesPorGrupo": {
      ".read": true,
      "$grupo": {
        ".validate": "$grupo.matches(/^(A|B|AB|0)[+-]$/)",
        "$nuhsa": {
          ".write": true,
          ".validate": "newData.child('grupoSanguineo').val() === $grupo && newData.child('nuhsa').val() === $nuhsa"
        }
      }
    }
  }
}
