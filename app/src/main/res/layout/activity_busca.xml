<?xml version="1.0" encoding="utf-8"?>
<!-- MODIFICADO: ficha con NUHSA y fecha de nacimiento, y botones para editar y borrar -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BuscaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/EtiquetaFicha"
            android:text="@string/etiqueta_nuhsa" />

        <TextView
            android:id="@+id/tvNuhsa"
            style="@style/ValorFicha" />

        <TextView
            style="@style/EtiquetaFicha"
            android:text="@string/etiqueta_nombre" />

        <TextView
            android:id="@+id/tvNombre"
            style="@style/ValorFicha" />

        <TextView
            style="@style/EtiquetaFicha"
            android:text="@string/etiqueta_apellidos" />

        <TextView
            android:id="@+id/tvApellidos"
            style="@style/ValorFicha" />

        <TextView
            style="@style/EtiquetaFicha"
            android:text="@string/etiqueta_grupo" />

        <TextView
            android:id="@+id/tvGrupoSanguineo"
            style="@style/ValorFicha" />

        <TextView
            style="@style/EtiquetaFicha"
            android:text="@string/etiqueta_fecha" />

        <TextView
            android:id="@+id/tvFechaNacimiento"
            style="@style/ValorFicha" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEditar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/editar" />

            <Button
                android:id="@+id/btnBorrar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/borrar"
                android:textColor="@color/rojo_borrar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
