<?xml version="1.0" encoding="utf-8"?>
<!-- MODIFICADO: nueva pantalla principal con alta por formulario, búsqueda validada y acceso al listado -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="88dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/principal_titulo"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/principal_subtitulo"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

            <Button
                android:id="@+id/btnAltaPaciente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/alta_paciente" />

            <Button
                android:id="@+id/btnPacienteAleatorio"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/paciente_aleatorio" />

            <Button
                android:id="@+id/btnListadoPacientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/listado_pacientes" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="8dp"
                android:text="@string/buscar_titulo"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNuhsaBusqueda"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_nuhsa">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNuhsaBusqueda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="textNoSuggestions|textCapCharacters"
                    android:maxLength="20" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnBuscarPaciente"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/buscar_paciente" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:contentDescription="@string/menu_opciones"
        app:backgroundTint="@color/white"
        app:elevation="6dp"
        app:srcCompat="@drawable/ic_menu"
        app:tint="?attr/colorOnSurface" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
